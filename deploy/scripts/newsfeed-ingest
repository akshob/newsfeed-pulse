#!/bin/bash
# /usr/local/bin/newsfeed-ingest [score-model] [catchup-model]
#
# Hourly pipeline: ingest → score → catchup-all. Two model args:
#   $1 = score model (LLM rerank: relevance_score / tldr / why_this / lane)
#   $2 = catchup-all model (catchup_html prose)
#   $2 defaults to $1 if not given (back-compat with the single-arg form).
#
# We split the two because chat-LLM size has different leverage on each
# step. The catchup explainer is structured prose (background / what's
# new / two strongest takes) and visibly benefits from a bigger model;
# the rerank is JSON output that 7B handles fine. So daytime can run
# score=7B (fast, JSON-safe) while still getting 32B-quality explainers.
#
# Embeddings (article + user profile) always use nomic-embed-text on
# hydrogen-localhost regardless — no chat model involved.
#
# Timestamped per-run logs at /mnt/butterscotch/newsfeed-pulse/logs/ingest/
# flock prevents overlapping runs across all crontab entries.
set -e

SCORE_MODEL="${1:-qwen2.5:7b}"
CATCHUP_MODEL="${2:-$SCORE_MODEL}"

APP_DIR=/mnt/butterscotch/newsfeed-pulse/app
LOG_DIR=/mnt/butterscotch/newsfeed-pulse/logs/ingest

mkdir -p "$LOG_DIR"
find "$LOG_DIR" -name 'ingest-*.log' -type f -mtime +30 -delete 2>/dev/null || true

TS=$(date -u +%Y-%m-%dT%H-%M-%SZ)
LOG="$LOG_DIR/ingest-$TS.log"

cd "$APP_DIR"
ln -sfn "$LOG" "$LOG_DIR/latest.log"

# Prevent overlapping runs (one shared lock across all crontab entries)
exec 9>/tmp/newsfeed-pipeline.lock
if ! flock -n 9; then
  echo "$(date -Iseconds) previous pipeline still running, skipping" >> "$LOG"
  exit 0
fi

exec >> "$LOG" 2>&1
echo "=== $(date -Iseconds) pipeline starting (pid $$, score=$SCORE_MODEL, catchup=$CATCHUP_MODEL) ==="

echo ''
echo '--- ingest ---'
./.build/release/NewsFeed ingest || echo '(ingest failed, continuing)'

echo ''
echo "--- score (model=$SCORE_MODEL) ---"
./.build/release/NewsFeed score --limit 100 --model "$SCORE_MODEL" || echo '(score failed, continuing)'

echo ''
echo "--- catchup-all (model=$CATCHUP_MODEL) ---"
./.build/release/NewsFeed catchup-all --limit 50 --model "$CATCHUP_MODEL" || echo '(catchup-all failed, continuing)'

echo ''
echo "=== $(date -Iseconds) pipeline done ==="
